#!/bin/bash
set -euo pipefail
# Send alert to Telegram when OpenClaw gateway fails or errors spike
# Deployed by Ansible — do not edit manually
# Token loaded from environment (EnvironmentFile in systemd)

HOSTNAME=$(hostname)
EVENT="${1:-unknown}"

escape_md() {
  # Escape Telegram Markdown v1 special characters: _ * ` [
  sed 's/[_*`[]/\\&/g'
}

case "$EVENT" in
  crash)
    LOGS=$(journalctl --user -u openclaw-gateway --no-pager -n 20 --output=short-iso 2>/dev/null | tail -15 | escape_md)
    MSG="🔴 *OpenClaw gateway crashed* on \`${HOSTNAME}\`

\`\`\`
${LOGS}
\`\`\`"
    ;;
  errors)
    COUNT="${2:-?}"
    MSG="⚠️ *OpenClaw error spike* on \`${HOSTNAME}\`: ${COUNT} errors in the last hour"
    ;;
  *)
    MSG="ℹ️ *OpenClaw alert* on \`${HOSTNAME}\`: $(echo "${EVENT}" | escape_md)"
    ;;
esac

curl -sf --max-time 10 \
  -X POST "https://api.telegram.org/bot${OPENCLAW_TELEGRAM_BOT_TOKEN}/sendMessage" \
  -d chat_id="${OPENCLAW_TELEGRAM_CHAT_ID}" \
  -d parse_mode="Markdown" \
  -d text="${MSG}" >/dev/null 2>&1
