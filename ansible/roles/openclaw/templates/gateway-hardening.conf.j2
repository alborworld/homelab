# Systemd hardening for openclaw-gateway user service
# Deployed by Ansible, survives `openclaw gateway install --force`

[Unit]
OnFailure=openclaw-notify-crash.service

[Service]
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
