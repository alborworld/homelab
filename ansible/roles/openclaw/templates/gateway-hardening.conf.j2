# Systemd hardening for openclaw-gateway user service
# Deployed by Ansible, survives `openclaw gateway install --force`

[Unit]
OnFailure=openclaw-notify-crash.service

[Service]
# Clean stale lock files before starting to prevent crash loops
ExecStartPre=/bin/sh -c 'rm -f /tmp/openclaw-$(id -u)/gateway.*.lock'
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
