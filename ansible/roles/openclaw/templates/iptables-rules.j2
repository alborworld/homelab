# OpenClaw network hardening
# Default DROP on all chains; explicit allowlist only
#
# Egress dependency inventory:
#   - Tailscale control plane (controlplane.tailscale.com:443, DERP relays :3478/:41641)
#   - Telegram Bot API (api.telegram.org:443)
#   - OpenAI / model provider APIs (:443)
#   - APT repos (deb.nodesource.com, archive.ubuntu.com :80/:443)
#   - DNS via local resolver ({{ dns_resolver }}:53)
#   - NTP (:123)
#
# If egress breaks: check `iptables -L -v -n` counters on DROP chains.
# Temporary debug: `iptables -I OUTPUT -j LOG --log-prefix "iptables-drop: "` then `dmesg`.

*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT DROP [0:0]

# Loopback
-A INPUT -i lo -j ACCEPT
-A OUTPUT -o lo -j ACCEPT

# Established/related connections
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A OUTPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# LAN SSH (Ansible provisioning from Proxmox host)
-A INPUT -s 10.0.4.0/24 -p tcp --dport 22 -j ACCEPT

# Tailscale interface (inter-node: Ollama, beszel, admin SSH)
-A INPUT -i tailscale0 -j ACCEPT
-A OUTPUT -o tailscale0 -j ACCEPT

# Tailscale WireGuard transport (must stay broad — DERP relays change)
-A INPUT -p udp --dport 41641 -j ACCEPT
-A OUTPUT -p udp --dport 41641 -j ACCEPT
-A OUTPUT -p udp --dport 3478 -j ACCEPT

# DNS (pinned to local resolver)
-A OUTPUT -p udp -d {{ dns_resolver }}/32 --dport 53 -j ACCEPT
-A OUTPUT -p tcp -d {{ dns_resolver }}/32 --dport 53 -j ACCEPT

# NTP
-A OUTPUT -p udp --dport 123 -j ACCEPT

# Block HTTP/HTTPS to LAN (prevent access to gateway admin UI, local devices)
-A OUTPUT -d {{ lan_subnet }} -p tcp --dport 443 -j DROP
-A OUTPUT -d {{ lan_subnet }} -p tcp --dport 80 -j DROP

# Outbound HTTPS (Telegram API, OpenAI API, Tailscale control, apt repos)
-A OUTPUT -p tcp --dport 443 -j ACCEPT

# Outbound HTTP (apt updates, ACME)
-A OUTPUT -p tcp --dport 80 -j ACCEPT

COMMIT
